{
  "name": "wb-price-manager",
  "productName": "WB Price Manager",
  "version": "1.3.6",
  "description": "Десктоп-приложение для управления ценами на Wildberries: массовая переценка, контроль входа в акции и расчёт юнит-экономики по данным API личного кабинета",
  "main": "electron/main.js",
  "author": "WB Price Manager",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "ui": "node tools/serve.js",
    "ui:demo": "node tools/serve.js --demo",
    "web": "node tools/web-server.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --win --dir",
    "test": "node tools/checks/updater-flow.js && node tools/checks/rate-limit-flow.js && node tools/checks/repricer-flow.js && node tools/checks/promo-analytics-flow.js && node tools/checks/workspace-v4-flow.js && node tools/checks/sales-contract.js && node tools/checks/finance-contract.js && node tools/checks/local-drafts-flow.js && node tools/checks/workspace-v4-ui-flow.js && node tools/checks/workspace-upgrade-flow.js && node tools/checks/promo-export-schema-flow.js && node tools/checks/promo-cabinet-flow.js && node tools/checks/engine-unit.js && node tools/checks/custom-strategy-flow.js && node tools/checks/price-watch-flow.js && node tools/checks/stocks-flow.js && node tools/checks/backup-flow.js && node tools/checks/backup-integration-flow.js && node tools/checks/profiles-flow.js && node tools/checks/notify-flow.js && node tools/checks/web-server-flow.js && node --expose-gc --max-old-space-size=1400 tools/uitest.js",
    "test:backup": "node tools/checks/backup-flow.js && node tools/checks/backup-integration-flow.js",
    "test:notify": "node tools/checks/notify-flow.js",
    "test:engine": "node tools/checks/engine-unit.js",
    "test:stocks": "node tools/checks/stocks-flow.js",
    "test:limits": "node tools/checks/rate-limit-flow.js",
    "test:repricer": "node tools/checks/repricer-flow.js",
    "test:promo-analytics": "node tools/checks/promo-analytics-flow.js",
    "test:ui": "node --expose-gc --max-old-space-size=1400 tools/uitest.js",
    "test:pricewatch": "node tools/checks/price-watch-flow.js",
    "test:web": "node tools/checks/web-server-flow.js",
    "test:profiles": "node tools/checks/profiles-flow.js",
    "test:workspace": "node tools/checks/workspace-upgrade-flow.js",
    "test:promo-file": "node tools/checks/promo-export-schema-flow.js",
    "test:promo-cabinet": "node tools/checks/promo-cabinet-flow.js",
    "test:workspace-v4": "node tools/checks/workspace-v4-flow.js && node tools/checks/sales-contract.js && node tools/checks/finance-contract.js && node tools/checks/local-drafts-flow.js && node tools/checks/workspace-v4-ui-flow.js"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "latest",
    "electron-updater": "^6.8.11",
    "jsdom": "^25.0.1"
  },
  "build": {
    "appId": "ru.wbpricemanager.app",
    "productName": "WB Price Manager",
    "artifactName": "WBPriceManager-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/debug/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/ms/**/*",
      "node_modules/semver/**/*",
      "node_modules/sax/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/universalify/**/*",
      "!**/.data/**",
      "!**/*.log",
      "!tools/checks/**",
      "!**/test/**",
      "!**/tests/**",
      "!**/testdata/**",
      "!**/coverage/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WB Price Manager",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerLanguages": [
        "ru_RU"
      ]
    },
    "portable": {
      "artifactName": "WBPriceManager-Portable-${version}.${ext}"
    },
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Defaulf-cpu",
        "repo": "wb-price-manager"
      }
    ]
  }
}
